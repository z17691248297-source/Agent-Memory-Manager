FROM python:3.11-slim
WORKDIR /workspace/agentmem
COPY . /workspace/agentmem
RUN python -m pip install --no-cache-dir -r requirements.txt && \
    useradd -m -u 10001 agentmem && \
    mkdir -p /workspace/agentmem/results && chown -R agentmem:agentmem /workspace/agentmem
USER agentmem
ENV PYTHONUNBUFFERED=1
HEALTHCHECK --interval=30s --timeout=5s --retries=3 CMD python -m agentmem --help >/dev/null || exit 1
ENTRYPOINT ["/workspace/agentmem/docker/entrypoint-agent.sh"]
